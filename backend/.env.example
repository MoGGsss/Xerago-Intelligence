# Copy to .env and set your local MySQL root password.
# Loaded from backend/.env (not dependent on shell cwd).

# --- MySQL (discrete settings — recommended for local dev) ---
# If DATABASE_URL is set below, it overrides MYSQL_* entirely.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_root_password_here
MYSQL_DATABASE=xerago_intelligence
MYSQL_CHARSET=utf8mb4
DB_ECHO=false

# --- Optional full URL (overrides MYSQL_* when uncommented) ---
# DATABASE_URL=mysql+pymysql://root:your_root_password_here@127.0.0.1:3306/xerago_intelligence

# --- Paths (optional) ---
# PROJECT_ROOT=D:\xerago-intelligence-engine
